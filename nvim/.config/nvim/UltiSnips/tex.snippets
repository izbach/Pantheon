global !p
def math():
    return vim.eval('vimtex#syntax#in_mathzone()') == '1'

def comment():
    return vim.eval('vimtex#syntax#in_comment()') == '1'

def env(name):
    [x,y] = vim.eval("vimtex#env#is_inside('" + name + "')")
    return x != '0' and y != '0'
endglobal


snippet mk "Inline math" A
$ $1 $
endsnippet
	
snippet dm "Display math" A
$$
$1 
$$
endsnippet
		
