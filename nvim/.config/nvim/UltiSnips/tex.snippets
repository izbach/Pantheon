context "math()"
snippet rd "superscript" iA
^{$1}$0
endsnippet

context "math()"
snippet ttt "test math context" iA
MATHWORKS
endsnippet



### Environment
snippet card "Make Anki Card" b
\begin{card}
\front{$1}
\back{
	$2
}
